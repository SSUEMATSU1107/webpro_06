<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>種目の編集</title>
</head>
<body>
    <h1>トレーニング内容の編集</h1>
    <form action="/workout/update/<%= id %>" method="POST">
        <label>種目名: <input type="text" name="name" value="<%= data.name %>" required></label><br><br>
        <label>部位: <input type="text" name="part" value="<%= data.part %>" required></label><br><br>
        <label>回数: <input type="number" name="reps" value="<%= data.reps %>" required></label><br><br>
        <input type="submit" value="更新する">
    </form>
    <br>
    <a href="/workout/<%= id %>">キャンセル</a>
</body>
</html>